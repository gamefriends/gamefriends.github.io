# Hugo 默认输出目录
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Hugo 缓存目录
/.hugo_build.lock

# 本地临时文件
.DS_Store
Thumbs.db

# Node 模块 (如果你使用 npm/yarn)
/node_modules/

# 环境变量文件
.env
.env.*

# IDE/编辑器文件夹
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# 临时文件
*.log
*.tmp
*~
